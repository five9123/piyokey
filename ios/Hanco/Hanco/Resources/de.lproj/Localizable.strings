"curriculum.chapter_6_daily_conversation.item_7.meaning" = "Lass uns zusammen zu Mittag essen";
"curriculum.chapter_6_daily_conversation.item_8.reading" = "Jogeum pigonhaeyo";
"curriculum.chapter_6_daily_conversation.item_8.meaning" = "Ich bin etwas müde";
"curriculum.chapter_6_daily_conversation.item_9.reading" = "Jigeum jibe gayo";
"curriculum.chapter_6_daily_conversation.item_9.meaning" = "Ich gehe jetzt nach Hause";
"curriculum.chapter_6_daily_conversation.item_10.reading" = "Naeil dasi mannayo";
"curriculum.chapter_6_daily_conversation.item_10.meaning" = "Bis morgen";

"curriculum.chapter_6_fan_support.title" = "Fan-Kommentare";
"curriculum.chapter_6_fan_support.detail" = "Übe zehn herzliche Kommentare für deinen Lieblingsstar";
"curriculum.chapter_6_fan_support.item_1.reading" = "Geongang kkok chaenggyeoyo";
"curriculum.chapter_6_fan_support.item_1.meaning" = "Pass gut auf deine Gesundheit auf";
"curriculum.chapter_6_fan_support.item_2.reading" = "Hateu hae juseyo";
"curriculum.chapter_6_fan_support.item_2.meaning" = "Mach bitte ein Herz";
"curriculum.chapter_6_fan_support.item_3.reading" = "Unneun moseup joayo";
"curriculum.chapter_6_fan_support.item_3.meaning" = "Ich mag dein Lächeln";
"curriculum.chapter_6_fan_support.item_4.reading" = "Pyeongsaeng eungwonhalgeyo";
"curriculum.chapter_6_fan_support.item_4.meaning" = "Ich werde dich immer unterstützen";
"curriculum.chapter_6_fan_support.item_5.reading" = "Hwamyeon neomeoro seolleyo";
"curriculum.chapter_6_fan_support.item_5.meaning" = "Selbst durch den Bildschirm kribbelt es";
"curriculum.chapter_6_fan_support.item_6.reading" = "Daeum bangsongdo olgeyo";
"curriculum.chapter_6_fan_support.item_6.meaning" = "Ich komme auch zum nächsten Stream";
"curriculum.chapter_6_fan_support.item_7.reading" = "Oneuldo rejeondeuyeyo";
"curriculum.chapter_6_fan_support.item_7.meaning" = "Heute war wieder legendär";
"curriculum.chapter_6_fan_support.item_8.reading" = "Moksori jinjja joayo";
"curriculum.chapter_6_fan_support.item_8.meaning" = "Ich liebe deine Stimme";
"curriculum.chapter_6_fan_support.item_9.reading" = "Wa jwoseo gomawoyo";
"curriculum.chapter_6_fan_support.item_9.meaning" = "Danke, dass du gekommen bist";
"curriculum.chapter_6_fan_support.item_10.reading" = "Oneul chakjang choegoyeyo";
"curriculum.chapter_6_fan_support.item_10.meaning" = "Dein Outfit heute ist das Beste";
