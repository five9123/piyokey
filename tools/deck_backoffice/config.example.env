# Copy this file to tools/deck_backoffice/.env and add your secret key.
# Never commit the .env file.
OPENAI_API_KEY=

# Fast structured extraction is the default role for deck metadata generation.
PIYOKEY_OPENAI_MODEL=gpt-5.6-luna

# Korean MP3 generation uses the pinned gTTS 2.5.4 dependency with
# lang=ko, tld=com, and normal speed. Install it from the repository root:
# python3 -m pip install -r tools/requirements-audio.txt
# Prompt text is sent to the Google Translate speech service used by gTTS.
