# Copy these names to private ~/.gradle/gradle.properties or inject same-named environment values.
# Never commit real signing passwords, Play resource IDs, or a keystore.

PIYOKEY_APPLICATION_ID=app.piyokey.piyokey
# Set to exactly the application ID only after Play Console ownership and the user's choice are final.
PIYOKEY_APPLICATION_ID_CONFIRMED=
PIYOKEY_VERSION_CODE=8
PIYOKEY_VERSION_NAME=1.1.0

PIYOKEY_CATALOG_URL=
PIYOKEY_PRIVACY_URL=https://hancoweb.vercel.app/privacy
PIYOKEY_SUPPORT_URL=https://hancoweb.vercel.app/support
# Set true only after the PRD content-rights and fixed-pronunciation review is actually approved.
PIYOKEY_CONTENT_RIGHTS_CONFIRMED=false

PIYOKEY_UPLOAD_STORE_FILE=
PIYOKEY_UPLOAD_STORE_PASSWORD=
PIYOKEY_UPLOAD_KEY_ALIAS=
PIYOKEY_UPLOAD_KEY_PASSWORD=

