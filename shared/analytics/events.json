{
  "schema_version": 1,
  "description": "PIYOKEY anonymous, semantic product analytics allowlist. Raw text and identifiers are forbidden.",
  "forbidden_properties": [
    "distinct_id",
    "user_id",
    "name",
    "email",
    "phone",
    "advertising_id",
    "ip",
    "text",
    "input",
    "answer",
    "target",
    "deck_id",
    "deck_name",
    "item_id",
    "item_name",
    "user_deck_id",
    "hash",
    "path",
    "uri",
    "receipt"
  ],
  "properties": {
    "schema_version": { "type": "integer", "constant": 1 },
    "platform": { "type": "enum", "values": ["ios", "ipados", "android", "web"] },
    "app_version": { "type": "version" },
    "build_number": { "type": "build" },
    "locale": { "type": "enum", "values": ["ja", "en", "ko", "es", "de", "fr", "other"] },
    "entry_point": { "type": "enum", "values": ["cold_start", "foreground", "deep_link", "notification", "unknown"] },
    "feature": { "type": "enum", "values": ["home", "discover", "practice", "game", "my_page", "settings", "deck_maker", "web_landing", "web_support"] },
    "onboarding_step": { "type": "enum", "values": ["goal", "keyboard", "first_input", "hatch_1", "hatch_2", "hatch_3", "app_tour"] },
    "deck_source": { "type": "enum", "values": ["bundled", "catalog", "imported", "created", "review", "daily", "curriculum", "unknown"] },
    "deck_category": { "type": "enum", "values": ["beginner", "travel", "daily", "topik", "trend", "custom", "unknown"] },
    "session_kind": { "type": "enum", "values": ["lesson", "free_practice", "review", "daily", "game"] },
    "input_mode": { "type": "enum", "values": ["builtin", "builtin_korean_10key", "os_ime", "not_applicable"] },
    "game_mode": { "type": "enum", "values": ["flow", "acid_rain", "choseong", "word_match", "dictation", "spacing", "not_applicable"] },
    "difficulty": { "type": "enum", "values": ["beginner", "intermediate", "advanced", "custom", "not_applicable"] },
    "result": { "type": "enum", "values": ["completed", "failed", "cancelled"] },
    "reason": { "type": "enum", "values": ["user_closed", "background_timeout", "content_error", "unknown"] },
    "duration_bucket": { "type": "enum", "values": ["under_1m", "1_to_3m", "3_to_7m", "over_7m"] },
    "item_count_bucket": { "type": "enum", "values": ["1_to_3", "4_to_10", "11_to_30", "over_30"] },
    "score_bucket": { "type": "enum", "values": ["0", "1_to_999", "1000_to_4999", "5000_plus"] },
    "action": { "type": "enum", "values": ["created", "edited", "copied", "imported", "exported", "deleted", "shared", "saved_image"] },
    "purchase_state": { "type": "enum", "values": ["viewed", "started", "pending", "completed", "cancelled", "failed", "restored"] },
    "setting": { "type": "enum", "values": ["language", "theme", "input_mode", "practice_display", "sound", "analytics_consent", "diagnostics_consent"] },
    "value_bucket": { "type": "enum", "values": ["enabled", "disabled", "ja", "en", "ko", "es", "de", "fr", "light", "dark", "builtin", "os_ime", "learning", "focus", "other"] }
  },
  "common_required": ["schema_version", "platform", "app_version", "build_number", "locale"],
  "events": {
    "app_opened": { "required": ["entry_point"] },
    "feature_viewed": { "required": ["feature"] },
    "onboarding_step_completed": { "required": ["onboarding_step"] },
    "deck_downloaded": { "required": ["deck_source", "deck_category"] },
    "session_started": { "required": ["session_kind", "deck_source", "input_mode"], "optional": ["game_mode", "difficulty"] },
    "session_completed": { "required": ["session_kind", "result", "duration_bucket", "item_count_bucket"], "optional": ["deck_source", "input_mode", "game_mode", "difficulty"] },
    "session_abandoned": { "required": ["session_kind", "reason", "duration_bucket"], "optional": ["deck_source", "input_mode", "game_mode", "difficulty"] },
    "game_result": { "required": ["game_mode", "difficulty", "result", "score_bucket", "input_mode", "deck_source"] },
    "review_completed": { "required": ["item_count_bucket", "result"] },
    "deck_maker_action": { "required": ["action"], "optional": ["item_count_bucket", "deck_source"] },
    "purchase_flow": { "required": ["purchase_state"] },
    "setting_changed": { "required": ["setting", "value_bucket"] },
    "share_completed": { "required": ["action"], "optional": ["game_mode"] }
  }
}
