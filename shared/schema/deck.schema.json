{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanco.example/schema/deck.schema.json",
  "title": "Hanco Deck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deck_id",
    "version",
    "name",
    "author",
    "official",
    "type",
    "level",
    "tags",
    "created_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "deck_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "author": { "$ref": "#/$defs/author" },
    "official": { "type": "boolean" },
    "type": { "$ref": "#/$defs/deckType" },
    "level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tags": { "$ref": "#/$defs/tags" },
    "default_locale": { "$ref": "#/$defs/localeTag" },
    "localizations": { "$ref": "#/$defs/deckLocalizations" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "deckType": { "type": "string", "enum": ["word", "sentence"] },
    "localeTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^(?:(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[0-9][a-z0-9]{3}|[a-z0-9]{5,8}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?|x(?:-[a-z0-9]{1,8})+)$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nickname"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "deckLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "author_nickname", "tags"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author_nickname": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "deckLocalizations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/localeTag" },
      "additionalProperties": { "$ref": "#/$defs/deckLocalization" },
      "minProperties": 1,
      "properties": {}
    },
    "itemLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reading", "meaning"],
      "properties": {
        "reading": { "type": "string", "minLength": 1, "maxLength": 300 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "itemLocalizations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/localeTag" },
      "additionalProperties": { "$ref": "#/$defs/itemLocalization" },
      "minProperties": 1,
      "properties": {}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ko", "reading_ja", "meaning_ja", "audio"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ko": { "type": "string", "minLength": 1, "maxLength": 10 },
        "reading_ja": { "type": "string", "minLength": 1, "maxLength": 300 },
        "meaning_ja": { "type": "string", "minLength": 1, "maxLength": 500 },
        "localizations": { "$ref": "#/$defs/itemLocalizations" },
        "audio": {
          "oneOf": [
            { "type": "string", "minLength": 1, "format": "uri-reference" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
