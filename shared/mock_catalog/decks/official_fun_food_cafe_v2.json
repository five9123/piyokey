    {
      "id": "i_001",
      "ko": "디저트는 못 참아",
      "reading_ja": "ティジョトゥヌン モッ チャマ",
      "meaning_ja": "デザートは我慢できない",
      "audio": "audio/ko_e38d7b64228e32f4d85d.mp3",
      "localizations": {
        "en": {
          "meaning": "I can't resist dessert",
          "reading": "dijeoteuneun mot chama"
        }
      }
    },
    {
      "id": "i_002",
      "ko": "여기 또 오고 싶다",
      "reading_ja": "ヨギ ト オゴ シプタ",
      "meaning_ja": "ここにまた来たい",
      "audio": "audio/ko_921c21fc461a5d8eb4f1.mp3",
      "localizations": {
        "en": {
          "meaning": "I want to come here again",
          "reading": "yeogi tto ogo sipda"
        }
      }
    },
    {
      "id": "i_003",
      "ko": "매운맛 도전할게요",
      "reading_ja": "メウンマッ トジョナルケヨ",
      "meaning_ja": "辛い味に挑戦します",
      "audio": "audio/ko_6f24f8ff089e493c704b.mp3",
      "localizations": {
        "en": {
          "meaning": "I'll try the spicy version",
          "reading": "maeunmat dojeonhalgeyo"
        }
      }
    },
    {
      "id": "i_004",
      "ko": "아이스로 주세요",
      "reading_ja": "アイスロ ジュセヨ",
      "meaning_ja": "アイスでください",
      "audio": "audio/ko_92ef2d58b56dd6b421c5.mp3",
      "localizations": {
        "en": {
          "meaning": "Iced, please",
          "reading": "aiseuro juseyo"
        }
      }
    },
    {
      "id": "i_005",
      "ko": "덜 맵게 해 주세요",
      "reading_ja": "トル メプケ ヘ ジュセヨ",
      "meaning_ja": "辛さ控えめにしてください",
      "audio": "audio/ko_6e3cf6662cd83e3e9306.mp3",
      "localizations": {
        "en": {
          "meaning": "Please make it less spicy",
          "reading": "deol maepge hae juseyo"
        }
      }
    },
    {
      "id": "i_006",
      "ko": "이거 진짜 맛있다",
      "reading_ja": "イゴ チンチャ マシッタ",
      "meaning_ja": "これ、本当においしい",
      "audio": "audio/ko_bcc105b025239446ce5e.mp3",
      "localizations": {
        "en": {
          "meaning": "This is really delicious",
          "reading": "igeo jinjja matitda"
        }
      }
    },
    {
      "id": "i_007",
      "ko": "한입만 주세요",
      "reading_ja": "ハニムマン ジュセヨ",
      "meaning_ja": "一口だけください",
      "audio": "audio/ko_9c1e4289632221260870.mp3",
      "localizations": {
        "en": {
          "meaning": "Just one bite, please",
          "reading": "hanipman juseyo"
        }
      }
    },
    {
      "id": "i_008",
      "ko": "사진부터 찍자",
      "reading_ja": "サジンブト チクチャ",
