  "items": [
    {
      "id": "i_001",
      "ko": "다음에 또 만날래요",
      "reading_ja": "タウメ ト マンナルレヨ",
      "meaning_ja": "また会いませんか",
      "audio": "audio/ko_eae16238ffaff4e2f009.mp3",
      "localizations": {
        "en": {
          "meaning": "Would you like to meet again?",
          "reading": "daeume tto mannalraeyo"
        }
      }
    },
    {
      "id": "i_002",
      "ko": "오늘 분위기 좋네요",
      "reading_ja": "オヌル プニギ チョンネヨ",
      "meaning_ja": "今日は雰囲気がいいですね",
      "audio": "audio/ko_16c6eafb3da47328cfcf.mp3",
      "localizations": {
        "en": {
          "meaning": "The vibe is nice today",
          "reading": "oneul bunwigi johneyo"
        }
      }
    },
    {
      "id": "i_003",
      "ko": "우리 잘 통하네요",
      "reading_ja": "ウリ チャル トンハネヨ",
      "meaning_ja": "私たち気が合いますね",
      "audio": "audio/ko_62eb50852d1d4b4d0dfe.mp3",
      "localizations": {
        "en": {
          "meaning": "We really click",
          "reading": "uri jal tonghaneyo"
        }
      }
    },
    {
      "id": "i_004",
      "ko": "취향이 비슷하네요",
      "reading_ja": "チュィヒャンイ ピスッタネヨ",
      "meaning_ja": "好みが似ていますね",
      "audio": "audio/ko_f36d7580b435f1893651.mp3",
      "localizations": {
        "en": {
          "meaning": "We have similar tastes",
          "reading": "chwihyangi biseuthaneyo"
        }
      }
    },
    {
      "id": "i_005",
      "ko": "같이 있으면 편해요",
      "reading_ja": "カチ イッスミョン ピョネヨ",
      "meaning_ja": "一緒にいると落ち着きます",
      "audio": "audio/ko_86e132b556044f30a848.mp3",
      "localizations": {
        "en": {
          "meaning": "I feel at ease with you",
          "reading": "gati iteumyeon pyeonhaeyo"
        }
      }
    },
    {
      "id": "i_006",
      "ko": "같이 데이트할래요",
      "reading_ja": "カチ テイトゥハルレヨ",
      "meaning_ja": "一緒にデートしませんか",
      "audio": "audio/ko_fc3441e964ec494c4f61.mp3",
      "localizations": {
        "en": {
          "meaning": "Would you like to go on a date?",
          "reading": "gati deiteuhalraeyo"
        }
      }
    },
    {
      "id": "i_007",
      "ko": "혹시 자주 와요",
      "reading_ja": "ホクシ チャジュ ワヨ",
      "meaning_ja": "ここにはよく来ますか",
      "audio": "audio/ko_a5ba3dc94720b177cedf.mp3",
      "localizations": {
        "en": {
          "meaning": "Do you come here often?",
          "reading": "hoksi jaju wayo"
        }
      }
    },
    {
      "id": "i_008",
      "ko": "웃는 게 예뻐요",
      "reading_ja": "ウンヌン ゲ イェッポヨ",
      "meaning_ja": "笑顔がきれいです",
      "audio": "audio/ko_90fcaf0f99ade69721e4.mp3",
      "localizations": {
        "en": {
          "meaning": "You have a beautiful smile",
          "reading": "utneun ge yeppeoyo"
        }
      }
    },
    {
      "id": "i_009",
      "ko": "더 알고 싶어요",
      "reading_ja": "ト アルゴ シポヨ",
      "meaning_ja": "もっと知りたいです",
      "audio": "audio/ko_ce070a09d1e9ffb5808d.mp3",
      "localizations": {
        "en": {
          "meaning": "I want to know more",
          "reading": "deo algo sipeoyo"
        }
      }
    },
    {
      "id": "i_010",
      "ko": "같이 커피 마실래요",
      "reading_ja": "カチ コピ マシルレヨ",
      "meaning_ja": "一緒にコーヒーを飲みませんか",
      "audio": "audio/ko_81a578746ac71fc4a618.mp3",
      "localizations": {
        "en": {
          "meaning": "Would you like to have coffee?",
          "reading": "gati keopi masilraeyo"
        }
      }
    },
    {
      "id": "i_011",
      "ko": "번호 물어봐도 돼요",
      "reading_ja": "ポノ ムロボァド トェヨ",
      "meaning_ja": "連絡先を聞いてもいいですか",
      "audio": "audio/ko_ab97ca7ecc0674bbc667.mp3",
      "localizations": {
        "en": {
          "meaning": "Can I ask for your number?",
          "reading": "beonho muleobwado dwaeyo"
        }
      }
    },
    {
      "id": "i_012",
      "ko": "첫눈에 반했어요",
      "reading_ja": "チョンヌネ パネッソヨ",
      "meaning_ja": "一目ぼれしました",
      "audio": "audio/ko_2fb61c57d7afc9956791.mp3",
      "localizations": {
        "en": {
          "meaning": "I fell in love at first sight",
          "reading": "cheotnune banhaeteoyo"
        }
      }
    }
  ],
