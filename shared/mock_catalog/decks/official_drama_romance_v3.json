  "items": [
    {
      "id": "i_001",
      "ko": "내 마음이 들리나요",
      "reading_ja": "ネ マウミ トゥルリナヨ",
      "meaning_ja": "私の心が聞こえますか",
      "audio": "audio/ko_9995442d7393ba3d7ca2.mp3",
      "localizations": {
        "en": {
          "meaning": "Can you hear my heart?",
          "reading": "nae maeumi deulrinayo"
        }
      }
    },
    {
      "id": "i_002",
      "ko": "천천히 다가와 줘",
      "reading_ja": "チョンチョニ タガワ ジョ",
      "meaning_ja": "ゆっくり近づいてきて",
      "audio": "audio/ko_fac3c83d0b44aa65956a.mp3",
      "localizations": {
        "en": {
          "meaning": "Come closer slowly",
          "reading": "cheoncheonhi dagawa jwo"
        }
      }
    },
    {
      "id": "i_003",
      "ko": "이번엔 놓치지 않아",
      "reading_ja": "イボネン ノッチジ アナ",
      "meaning_ja": "今度は離さない",
      "audio": "audio/ko_7566019474d6a3f510dd.mp3",
      "localizations": {
        "en": {
          "meaning": "I won't let go this time",
          "reading": "ibeonen nohchiji ana"
        }
      }
    },
    {
      "id": "i_004",
      "ko": "인연",
      "reading_ja": "イニョン",
      "meaning_ja": "縁",
      "audio": "audio/ko_f484988a6ef7f6fae724.mp3",
      "localizations": {
        "en": {
          "meaning": "destined connection",
          "reading": "inyeon"
        }
      }
    },
    {
      "id": "i_005",
      "ko": "첫사랑",
      "reading_ja": "チョッサラン",
      "meaning_ja": "初恋",
      "audio": "audio/ko_48a5a8b2aea4dfccaf88.mp3",
      "localizations": {
        "en": {
          "meaning": "first love",
          "reading": "cheotsarang"
        }
      }
    },
    {
      "id": "i_006",
      "ko": "잠깐만요",
      "reading_ja": "チャムカンマンニョ",
      "meaning_ja": "ちょっと待ってください",
      "audio": "audio/ko_9eb28c45e4e577e49d13.mp3",
      "localizations": {
        "en": {
          "meaning": "Just a moment, please",
          "reading": "jamkkanmanyo"
        }
      }
    },
    {
      "id": "i_007",
      "ko": "보고 싶었어",
      "reading_ja": "ポゴ シポッソ",
      "meaning_ja": "会いたかった",
      "audio": "audio/ko_d10675e8b2d5f38051c5.mp3",
      "localizations": {
        "en": {
          "meaning": "I missed you",
          "reading": "bogo sipeoteo"
        }
      }
    },
    {
      "id": "i_008",
      "ko": "내 옆에 있어 줘",
      "reading_ja": "ネ ヨペ イッソ ジョ",
      "meaning_ja": "私のそばにいて",
      "audio": "audio/ko_9d0527584bd414c1a7ad.mp3",
      "localizations": {
        "en": {
          "meaning": "Stay by my side",
          "reading": "nae yeope iteo jwo"
        }
      }
    },
    {
      "id": "i_009",
      "ko": "왜 이제 왔어요",
      "reading_ja": "ウェ イジェ ワッソヨ",
      "meaning_ja": "どうして今来たのですか",
      "audio": "audio/ko_cd6877bd91f9a97c649a.mp3",
      "localizations": {
        "en": {
          "meaning": "Why did you come so late?",
          "reading": "wae ije wateoyo"
        }
      }
    },
    {
      "id": "i_010",
      "ko": "오늘은 가지 마요",
      "reading_ja": "オヌルン カジ マヨ",
      "meaning_ja": "今日は行かないで",
      "audio": "audio/ko_71c5a1a96b3ee49bfe0d.mp3",
      "localizations": {
        "en": {
          "meaning": "Don't go today",
          "reading": "oneuleun gaji mayo"
        }
      }
    },
    {
      "id": "i_011",
      "ko": "우리 다시 시작해",
      "reading_ja": "ウリ タシ シジャケ",
      "meaning_ja": "私たち、やり直そう",
      "audio": "audio/ko_b7ccaf8824597a152913.mp3",
      "localizations": {
        "en": {
          "meaning": "Let's start over",
          "reading": "uri dasi sijakhae"
        }
      }
    },
    {
      "id": "i_012",
      "ko": "그날부터 좋아했어",
      "reading_ja": "クナルブト チョアヘッソ",
      "meaning_ja": "あの日から好きだった",
      "audio": "audio/ko_d6658cbb8c22bde6ab65.mp3",
      "localizations": {
        "en": {
          "meaning": "I've liked you since that day",
          "reading": "geunalbuteo johahaeteo"
        }
      }
    }
  ],
